# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# This is an example environment file that serves as a template for the
# OPTIONAL environment variable overrides accepted by the Node.js Express
# tutorial application. None of these variables is required.
#
# The application runs with no `.env` file at all, because every setting has a
# built-in default: config/index.js is the only module in this codebase that
# reads process.env, and every one of its reads has a literal fallback. With
# no `.env` present and nothing exported, the configuration loads clean
# (port 3000, host localhost, app name node-tutorial-app) and `GET /hello`
# answers 200 with the body `Hello world`.
#
# INSTRUCTIONS:
# 1. Copy this file to `.env` in the same directory ONLY if you want to
#    override one of the defaults documented below; skip this step to run on
#    the built-in defaults
# 2. Update the values below according to your environment
# 3. Never commit the actual `.env` file to version control
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# PORT - Defines the port on which the Node.js server will listen for incoming HTTP requests
# The technical specification designates 3000 as the default port (F-001-RQ-003)
# Default: 3000
# Recommended range: 1024-65535 - the non-privileged ports. This is a
# recommendation, not the range of legal values; the three statements below are
# separate and all three apply.
# 1. What Node and the OS accept: 0-65535. A value outside that range makes
#    listen() throw
#    `RangeError [ERR_SOCKET_BAD_PORT]: options.port should be >= 0 and < 65536`.
# 2. What this application does with the value: config/index.js computes
#    `parseInt(process.env.PORT, 10) || 3000`, so unset gives 3000, PORT=abc
#    gives 3000, PORT=3000.7 gives 3000 (parseInt truncates), and PORT=0 also
#    gives 3000 because 0 is falsy - this application does not let you ask for
#    an OS-assigned port through PORT.
# 3. What validation does: config/index.js only warns and never rejects. A
#    value below 1024 or above 65535 is used exactly as given, after printing
#    `Warning: Port <n> is outside recommended range (1024-65535)`. So PORT=80
#    really binds port 80 - ports 1-1023 are privileged on Unix-like systems
#    and normally need elevated privileges - while PORT=70000 warns at startup
#    and then crashes at listen with ERR_SOCKET_BAD_PORT.
PORT=3000

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================

# NODE_ENV - Specifies the environment in which the application is running
# Accepted values: development, test, production
# Default: development (for local development and tutorial purposes)
NODE_ENV=development

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# HOST - The hostname recorded as the server's configured host
# Default: localhost (for local development only)
# READ: yes, but it does NOT control the bind interface. config/index.js reads
# it into config.host, and the startup summary prints it as "Host: <value>",
# yet server.js calls server.listen(config.port, ...) with no host argument,
# so Node binds every available interface regardless of the value set here.
# Docker: a container does NOT need HOST=0.0.0.0 for a published port to be
# reachable, because that port-only listen() form already binds all
# interfaces: the observed bound address is '::'. The port-only form is
# deliberate, not an oversight, and the reason is tied to the default value
# this template ships rather than to the host argument in general. With
# HOST=localhost, passing config.host would resolve to 127.0.0.1 and bind
# loopback only, so the container would answer on loopback alone and
# `docker run -p 3000:3000` would be unreachable from the host. A configured
# HOST=0.0.0.0 would not do that - it would bind 0.0.0.0, all IPv4
# interfaces. Both are hypothetical today, because the value never reaches
# listen() at all: setting HOST=0.0.0.0 changes nothing either way.
HOST=localhost

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# ENABLE_LOGGING - Reads as a master logging switch, but the name is broader
# than the behaviour: today it is effectively a configuration-summary switch.
# Accepted values: true, false (any value other than the literal string
# "false" is read as true)
# Default: true
# READ: yes, and it has exactly one effect - whether the development
# configuration summary is printed. config/index.js reads it into
# config.development.enableLogging, and that value is consumed in exactly two
# places, both in config/index.js: the gate that prints the
# "Configuration loaded successfully:" block, and the "Logging:" line inside
# that block. The summary is additionally gated on NODE_ENV === 'development',
# so it never prints outside development however this variable is set.
# What it does NOT do: it does not disable request logging, startup logging or
# error logging. The request logger is mounted unconditionally in app.js, and
# utils/logger.js branches only on NODE_ENV, never on this setting. Running
# with ENABLE_LOGGING=false in development suppresses only the configuration
# summary - its "Configuration loaded successfully:" header and the five
# indented lines beneath it; the five startup lines and the per-request
# "HTTP Request - Method: GET Path: /hello Body: {}" line still appear.
# Log formatting is governed by NODE_ENV, not by this variable.
# Left commented out on purpose: the default is already true, so a copied
# `.env` does not need to set it.
# ENABLE_LOGGING=true

# LOG_LEVEL - Intended to control the verbosity of application logging
# Accepted values: error, warn, info, debug
# Default: info (appropriate for tutorial and development)
# READ: no - no module reads this variable. config/index.js is the only reader
# of process.env in this codebase and it never reads LOG_LEVEL, so setting it
# has no effect anywhere. It is retained as a documented convention for a
# future logging implementation.
# What controls log formatting today is NODE_ENV: utils/logger.js prefixes
# messages with "[INFO]:" / "[ERROR]:" when NODE_ENV is development, and omits
# the prefix in every other environment.
LOG_LEVEL=info

# =============================================================================
# TUTORIAL NOTES
# =============================================================================
# This tutorial application implements a single HTTP endpoint (/hello) that
# returns "Hello world" for educational purposes. It demonstrates:
# - Node.js v22.16.0 LTS runtime environment
# - Express.js 5.1.0 web framework
# - Basic HTTP server initialization and request handling
# - Environment-based configuration patterns
#
# For production deployments, additional environment variables would typically
# include database connections, API keys, and security configurations.
# =============================================================================