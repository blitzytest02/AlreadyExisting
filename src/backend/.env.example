# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# This is an example environment file that serves as a template for the 
# required environment variables for the Node.js Express tutorial application.
# 
# INSTRUCTIONS:
# 1. A working `.env` is already committed in this directory, so a fresh clone needs no copy.
#    Create one from this template only if `.env` is missing: `[ -f .env ] || cp .env.example .env`
# 2. Update the values below according to your environment
# 3. Note that copying over an existing `.env` is not a no-op: `.env` sets
#    APP_NAME=nodejs-tutorial-hello-world and this template does not set APP_NAME at all, so the
#    startup banner would fall back to 'node-tutorial-app'. Every other setting is the same in both
#    files. `git checkout -- .env` restores the committed file
# 4. `.env` is committed here because it holds no credential. If you add a real one to this
#    package, add `.env` to `.gitignore` first and commit only this template
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# PORT - Defines the port on which the Node.js server will listen for incoming HTTP requests
# The technical specification designates 3000 as the default port (F-001-RQ-003)
# Valid port range: 1024-65535
# Default: 3000
PORT=3000

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================

# NODE_ENV - Specifies the environment in which the application is running
# Accepted values: development, test, production
# Default: development (for local development and tutorial purposes)
NODE_ENV=development

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# HOST - Reserved for future use; it does NOT control the bind address
# `config/index.js` reads this value and the startup summary prints it, but nothing passes it to
# `server.listen()`, which is called with a port only. Node therefore listens on every interface
# whatever HOST says - which is the behaviour the Docker health check and the Kubernetes probes
# need, so it is deliberate rather than a gap to close here.
# Default: localhost
# Note: setting 0.0.0.0 changes nothing; external access already works without it
HOST=localhost

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# LOG_LEVEL - Controls the verbosity of application logging
# Accepted values: error, warn, info, debug
# Default: info (appropriate for tutorial and development)
LOG_LEVEL=info

# =============================================================================
# TUTORIAL NOTES
# =============================================================================
# This tutorial application implements a single HTTP endpoint (/hello) that
# returns "Hello world" for educational purposes. It demonstrates:
# - Node.js 22.x LTS runtime environment (validated on v22.23.2; package.json requires >= 18.0.0)
# - Express 5.x web framework (5.2.1, resolved from the declared ^5.1.0)
# - Basic HTTP server initialization and request handling
# - Environment-based configuration patterns
#
# For production deployments, additional environment variables would typically
# include database connections, API keys, and security configurations.
# =============================================================================